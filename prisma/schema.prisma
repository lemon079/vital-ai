generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// ENUMS
// ============================================================

enum Sex {
  male
  female
  other
}

enum PregnancyStatus {
  not_pregnant
  first_trimester
  second_trimester
  third_trimester
  unknown
}

enum ReportStatus {
  uploaded
  processing
  extracted
  pending_review
  analyzed
  failed
}

enum MessageRole {
  user
  assistant
}

enum AgentType {
  qna
  followup
  summary
  system
}

enum ReviewStatus {
  auto_accepted
  pending_review
  user_confirmed
  user_corrected
}

enum LabFlag {
  normal
  high
  low
  critical_high
  critical_low
}

enum FlagBasis {
  report_printed_range
  internal_reference_db
}

// ============================================================
// CORE MODELS
// ============================================================

model User {
  id                    String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                 String           @unique
  password              String
  auth_provider_id      String?
  date_of_birth         DateTime?        @db.Date
  sex                   Sex?
  pregnancy_status      PregnancyStatus? @default(unknown)
  consent_health_data_at DateTime?       @db.Timestamptz(6)
  is_onboarded          Boolean          @default(false)
  created_at            DateTime         @default(now()) @db.Timestamptz(6)

  reports               Report[]
  conversations         Conversation[]
  lab_result_values      LabResultValue[]

  @@map("users")
}

model Report {
  id                    String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id               String       @db.Uuid
  file_uri              String?
  status                ReportStatus @default(uploaded)
  sample_collected_date DateTime?    @db.Date
  uploaded_at           DateTime     @default(now()) @db.Timestamptz(6)
  source_lab_name       String?
  has_critical_flag     Boolean      @default(false)
  critical_ack_at       DateTime?    @db.Timestamptz(6)

  user                  User              @relation(fields: [user_id], references: [id], onDelete: Cascade)
  conversations         Conversation[]
  lab_result_values      LabResultValue[]
  clinical_summaries     ClinicalSummary[]
  share_tokens          ReportShareToken[]

  @@map("reports")
}

model Conversation {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id                String    @db.Uuid
  report_id              String?   @db.Uuid
  title                  String?
  turn_count             Int       @default(0)
  proactive_suggested_at DateTime? @db.Timestamptz(6)
  created_at             DateTime  @default(now()) @db.Timestamptz(6)

  user           User                   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  report         Report?                @relation(fields: [report_id], references: [id], onDelete: SetNull)
  messages       Message[]
  guardrail_logs ResponseGuardrailLog[]

  @@map("conversations")
}

model Message {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversation_id String      @db.Uuid
  role            MessageRole
  agent_type      AgentType   @default(system)
  content         String
  created_at      DateTime    @default(now()) @db.Timestamptz(6)

  conversation    Conversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade)

  @@map("messages")
}

// ============================================================
// EXTRACTION & COMPARISON ENGINE MODELS
// ============================================================

model CanonicalTest {
  test_code    String  @id
  display_name String
  default_unit String?

  aliases           TestAlias[]
  unit_conversions  UnitConversion[]
  reference_ranges  ReferenceRange[]
  lab_result_values  LabResultValue[]

  @@map("canonical_tests")
}

model TestAlias {
  id         String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  alias_text String @unique
  test_code  String

  canonical_test CanonicalTest @relation(fields: [test_code], references: [test_code], onDelete: Cascade)

  @@map("test_aliases")
}

model UnitConversion {
  id              String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  test_code       String
  from_unit       String
  to_unit         String
  multiply_factor Decimal @db.Decimal

  canonical_test CanonicalTest @relation(fields: [test_code], references: [test_code], onDelete: Cascade)

  @@unique([test_code, from_unit, to_unit])
  @@map("unit_conversions")
}

model ReferenceRange {
  id                  String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  test_code           String
  sex                 Sex?
  age_min             Int?
  age_max             Int?
  pregnancy_trimester PregnancyStatus?
  low                 Decimal?         @db.Decimal
  high                Decimal?         @db.Decimal
  critical_low        Decimal?         @db.Decimal
  critical_high       Decimal?         @db.Decimal
  unit                String?
  specificity_rank    Int              @default(0)
  source_citation     String?
  effective_from      DateTime?        @db.Date
  effective_to        DateTime?        @db.Date

  canonical_test CanonicalTest @relation(fields: [test_code], references: [test_code], onDelete: Cascade)

  @@map("reference_ranges")
}

model LabResultValue {
  id                      String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  report_id               String       @db.Uuid
  user_id                 String       @db.Uuid
  test_code               String
  extracted_value_raw      String?
  confidence_score        Decimal?     @db.Decimal
  review_status           ReviewStatus @default(auto_accepted)
  value                   Decimal?     @db.Decimal
  unit                    String?
  report_stated_range_low  Decimal?    @db.Decimal
  report_stated_range_high Decimal?    @db.Decimal
  flag                    LabFlag?
  flag_basis              FlagBasis?
  created_at              DateTime     @default(now()) @db.Timestamptz(6)

  report         Report        @relation(fields: [report_id], references: [id], onDelete: Cascade)
  user           User          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  canonical_test CanonicalTest @relation(fields: [test_code], references: [test_code], onDelete: Cascade)

  @@map("lab_result_values")
}

// ============================================================
// AUDIT & LOGGING MODELS
// ============================================================

model ResponseGuardrailLog {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversation_id     String   @db.Uuid
  agent_type          AgentType
  flagged             Boolean  @default(false)
  flag_reason         String?
  final_response_sent String?
  created_at          DateTime @default(now()) @db.Timestamptz(6)

  conversation Conversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade)

  @@map("response_guardrail_logs")
}

model ClinicalSummary {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  report_id     String   @db.Uuid
  content       String
  pdf_uri       String?
  generated_at  DateTime @default(now()) @db.Timestamptz(6)
  model_version String?

  report Report @relation(fields: [report_id], references: [id], onDelete: Cascade)

  @@map("clinical_summaries")
}

model ReportShareToken {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  report_id  String    @db.Uuid
  token      String    @unique
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  expires_at DateTime? @db.Timestamptz(6)

  report Report @relation(fields: [report_id], references: [id], onDelete: Cascade)

  @@map("report_share_tokens")
}
